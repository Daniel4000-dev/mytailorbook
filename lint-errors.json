assName={styles.registerButton} style={{ marginTop: '24px' }}>\n            Back to Login\n          </Link>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className={styles.container}>\n      {/* Sewing Machine Logo */}\n      <div className={styles.logoWrapper}>\n        <BrandIcon alt=\"MyStitchBook\" className={styles.sewingMachineSvg} />\n      </div>\n\n      {/* Brand Title */}\n      <div className={styles.brandTitle}>\n        <BrandWordmark height={30} />\n      </div>\n\n      <form className={styles.form} onSubmit={handleSubmit(onSubmit)}>\n        {apiError && <div className={styles.errorBanner}>{apiError}</div>}\n\n        {/* Full Name Field */}\n        <div>\n          <AuthInput\n            id=\"name\"\n            type=\"text\"\n            label=\"Full Name\"\n            {...register('name')}\n          />\n          {errors.name && <div className={styles.errorText}>{errors.name.message}</div>}\n        </div>\n\n        {/* Email Field */}\n        <div style={{ marginTop: '1rem' }}>\n          <AuthInput\n            id=\"email\"\n            type=\"email\"\n            label=\"Email\"\n            {...register('email')}\n          />\n          {errors.email && <div className={styles.errorText}>{errors.email.message}</div>}\n        </div>\n\n        {/* Password Field */}\n        <div style={{ marginTop: '1rem' }}>\n          <AuthInput\n            id=\"password\"\n            type=\"password\"\n            label=\"Password\"\n            hasEyeIcon\n            {...register('password')}\n          />\n          {errors.password && <div className={styles.errorText}>{errors.password.message}</div>}\n        </div>\n\n        {/* Confirm Password Field */}\n        <div style={{ marginTop: '1rem' }}>\n          <AuthInput\n            id=\"confirmPw\"\n            type=\"password\"\n            label=\"Confirm Password\"\n            hasEyeIcon\n            {...register('confirmPw')}\n          />\n          {errors.confirmPw && <div className={styles.errorText}>{errors.confirmPw.message}</div>}\n        </div>\n\n        {/* Primary Submit Button */}\n        <button\n          type=\"submit\"\n          className={styles.loginButton}\n          disabled={submitting}\n          style={{ marginTop: '8px' }}\n        >\n          {submitting && <Symbol name=\"progress_activity\" className=\"global-spinner\" />}\n          {submitting ? 'Creating Account...' : 'Create Account'}\n        </button>\n\n        {/* Divider */}\n        <div className={styles.divider}>\n          <span className={styles.dividerLine} />\n          <span className={styles.dividerText}>or</span>\n          <span className={styles.dividerLine} />\n        </div>\n\n        {/* Google CTA */}\n        <button\n          type=\"button\"\n          className={styles.googleButton}\n          onClick={handleGoogle}\n          disabled={submitting || googleLoading}\n        >\n          {googleLoading && <Symbol name=\"progress_activity\" className=\"global-spinner\" />}\n          <svg className={styles.googleIcon} viewBox=\"0 0 24 24\" width=\"20\" height=\"20\">\n            <path\n              d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"\n              fill=\"#4285F4\"\n            />\n            <path\n              d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"\n              fill=\"#34A853\"\n            />\n            <path\n              d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z\"\n              fill=\"#FBBC05\"\n            />\n            <path\n              d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z\"\n              fill=\"#EA4335\"\n            />\n          </svg>\n          Sign up with Google\n        </button>\n\n        <p className={styles.agreeRow}>\n          By signing up, you agree to our{' '}\n          <Link href={ROUTES.terms} target=\"_blank\" rel=\"noopener noreferrer\">Terms of Service</Link>{' '}\n          and{' '}\n          <Link href={ROUTES.privacy} target=\"_blank\" rel=\"noopener noreferrer\">Privacy Policy</Link>.\n        </p>\n\n        {/* Footer label */}\n        <div className={styles.footerLabel}>Already have an account?</div>\n\n        {/* Secondary Link to Login */}\n        <Link href={ROUTES.login} className={styles.registerButton}>\n          Log in\n        </Link>\n      </form>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/mac/Desktop/mytailorbook/app/(marketing)/_components/HomePageContent.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/mac/Desktop/mytailorbook/app/(marketing)/about/_components/AboutPageContent.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/mac/Desktop/mytailorbook/app/(marketing)/about/page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/mac/Desktop/mytailorbook/app/(marketing)/contact/_components/ContactPageContent.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/mac/Desktop/mytailorbook/app/(marketing)/contact/page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"