#!/bin/sh
# -----------------------------------------------------------------------------
# Pre-Commit CI Pipeline Hook
# Ensures TypeScript compilation and unit tests pass before ANY commit.
# Blocks commits that would break the Vercel production/staging build.
# -----------------------------------------------------------------------------

set -e

echo "Running Pre-Commit CI checks..."

# 1. Typecheck: catch all missing props, broken imports, and TypeScript errors
echo "Checking TypeScript types (tsc --noEmit)..."
npx tsc --noEmit

# 2. Unit tests: catch regressions in routes, calculations, logic, and isolation
echo "Running unit test suite (npm run test:unit)..."
npm run test:unit

echo "All CI checks passed! Commit allowed."
