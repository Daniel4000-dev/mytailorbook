#!/bin/sh
# -----------------------------------------------------------------------------
# Pre-Commit CI Pipeline Hook
# Mirrors GitHub Actions CI pipeline:
# 1. Typecheck: npx tsc --noEmit
# 2. Linting: npm run lint
# 3. Unit + Integration Tests: npm run test
# Blocks commits that would break GitHub Actions CI or Vercel builds.
# -----------------------------------------------------------------------------

set -e

echo "Running Pre-Commit CI checks..."

# 1. Typecheck: catch all missing props, broken imports, and TypeScript errors
echo "Checking TypeScript types (tsc --noEmit)..."
npx tsc --noEmit

# 2. Lint: catch syntax and lint regressions
echo "Checking ESLint rules (npm run lint)..."
npm run lint

# 3. Unit + Integration tests: catch regressions across all test suites
echo "Running full test suite (npm run test)..."
npm run test

echo "All CI checks passed! Commit allowed."
